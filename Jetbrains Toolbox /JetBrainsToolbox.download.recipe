<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Description</key>
	<string>Downloads the current release of JetBrains Toolbox for Apple Silicon.</string>
	<key>Identifier</key>
	<string>com.github.JOSC-svs.download.JetBrainsToolbox</string>
	<key>Input</key>
	<dict>
		<key>NAME</key>
		<string>JetBrainsToolbox</string>
	</dict>
	<key>MinimumVersion</key>
	<string>2.4.1</string>
	<key>Process</key>
	<array>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>url</key>
				<string>https://data.services.jetbrains.com/products/releases?code=TBA&amp;latest=true&amp;type=release</string>
				<key>re_pattern</key>
				<string>"macM1":\{"link":"(?P&lt;url&gt;https://download\.jetbrains\.com/toolbox/jetbrains-toolbox-(?P&lt;version&gt;[0-9.]+)-arm64\.dmg)"</string>
			</dict>
			<key>Processor</key>
			<string>URLTextSearcher</string>
		</dict>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>filename</key>
				<string>%NAME%-%version%-arm64.dmg</string>
			</dict>
			<key>Processor</key>
			<string>URLDownloader</string>
		</dict>
		<dict>
			<key>Processor</key>
			<string>EndOfCheckPhase</string>
		</dict>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>input_path</key>
				<string>%pathname%/JetBrains Toolbox.app</string>
				<key>requirement</key>
				<string>identifier "com.jetbrains.toolbox" and anchor apple generic and certificate leaf[subject.OU] = "2BFCWG5935"</string>
			</dict>
			<key>Processor</key>
			<string>CodeSignatureVerifier</string>
		</dict>
	</array>
</dict>
</plist>

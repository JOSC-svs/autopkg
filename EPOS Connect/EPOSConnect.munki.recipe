<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Description</key>
	<string>Downloads the current release of EPOS Connect and imports into Munki.</string>
	<key>Identifier</key>
	<string>com.github.JOSC-svs.munki.EPOSConnect</string>
	<key>Input</key>
	<dict>
		<key>NAME</key>
		<string>EPOS Connect</string>
		<key>MUNKI_REPO_SUBDIR</key>
		<string>apps/EPOS Connect</string>
		<key>MUNKI_CATEGORY</key>
		<string>Utilities</string>
		<key>pkginfo</key>
		<dict>
			<key>blocking_applications</key>
			<array>
				<string>EPOS Connect.app</string>
			</array>
			<key>catalogs</key>
			<array>
				<string>testing</string>
			</array>
			<key>category</key>
			<string>%MUNKI_CATEGORY%</string>
			<key>description</key>
			<string>Keeps EPOS headsets and speakerphones updated and provides access to device settings and call control.</string>
			<key>developer</key>
			<string>EPOS</string>
			<key>display_name</key>
			<string>EPOS Connect</string>
			<key>name</key>
			<string>%NAME%</string>
			<key>unattended_install</key>
			<true/>
			<key>version</key>
			<string>%version%</string>
		</dict>
	</dict>
	<key>MinimumVersion</key>
	<string>2.4.1</string>
	<key>ParentRecipe</key>
	<string>com.github.JOSC-svs.download.EPOSConnect</string>
	<key>Process</key>
	<array>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>pkg_path</key>
				<string>%pathname%</string>
				<key>repo_subdirectory</key>
				<string>%MUNKI_REPO_SUBDIR%</string>
			</dict>
			<key>Processor</key>
			<string>MunkiImporter</string>
		</dict>
	</array>
</dict>
</plist>

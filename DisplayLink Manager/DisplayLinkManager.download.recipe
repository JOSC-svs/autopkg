<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Description</key>
	<string>Downloads the current release of DisplayLink Manager.</string>
	<key>Identifier</key>
	<string>com.github.JOSC-svs.download.DisplayLinkManager</string>
	<key>Input</key>
	<dict>
		<key>NAME</key>
		<string>DisplayLink Manager</string>
	</dict>
	<key>MinimumVersion</key>
	<string>2.4.1</string>
	<key>Process</key>
	<array>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>url</key>
				<string>https://www.synaptics.com/products/displaylink-graphics/downloads/macos</string>
				<key>re_pattern</key>
				<string>(?s)&lt;div class="latest-official-drivers"&gt;.*?Release:\s*(?P&lt;version&gt;[0-9.]+).*?&lt;a href="(?P&lt;product_url&gt;/products/displaylink-manager-graphics-connectivity-[^"]+\?filetype=exe)"</string>
			</dict>
			<key>Processor</key>
			<string>URLTextSearcher</string>
		</dict>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>url</key>
				<string>https://www.synaptics.com%product_url%</string>
				<key>re_pattern</key>
				<string>&lt;a class="no-link" href="(?P&lt;download_url&gt;/sites/default/files/exe_files/[^"]+\.pkg)" download&gt;Accept&lt;/a&gt;</string>
			</dict>
			<key>Processor</key>
			<string>URLTextSearcher</string>
		</dict>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>url</key>
				<string>https://www.synaptics.com%download_url%</string>
				<key>filename</key>
				<string>%NAME%-%version%.pkg</string>
			</dict>
			<key>Processor</key>
			<string>URLDownloader</string>
		</dict>
		<dict>
			<key>Processor</key>
			<string>EndOfCheckPhase</string>
		</dict>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>input_path</key>
				<string>%pathname%</string>
				<key>expected_authority_names</key>
				<array>
					<string>Developer ID Installer: DisplayLink Corp (73YQY62QM3)</string>
					<string>Developer ID Certification Authority</string>
					<string>Apple Root CA</string>
				</array>
				<key>deep_verification</key>
				<true/>
				<key>strict_verification</key>
				<true/>
			</dict>
			<key>Processor</key>
			<string>CodeSignatureVerifier</string>
		</dict>
	</array>
</dict>
</plist>
